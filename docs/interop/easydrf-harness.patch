+/* DecHAMDRM interop harness, transmit side: EASYDRF_TXWAV=out.wav writes the transmit
+   audio (left channel, 48 kHz mono 16-bit) to a file instead of the sound card, paced at
+   EASYDRF_SPEED x real time; EASYDRF_MIC=speech.wav stands in for the microphone.
+   No sound device is opened. Local test build only. */
+#include <mutex>
+static FILE* g_txwav = nullptr;
+static long long g_txsamples = 0;
+static std::mutex g_txlock;
+void HarnessFinishTx()
+{
+	g_txlock.lock();
+	if (g_txwav) {
+		unsigned int data = (unsigned int)(g_txsamples * 2), riff = data + 36;
+		fseek(g_txwav, 4, SEEK_SET); fwrite(&riff, 4, 1, g_txwav);
+		fseek(g_txwav, 40, SEEK_SET); fwrite(&data, 4, 1, g_txwav);
+		fclose(g_txwav); g_txwav = nullptr;
+	}
+	ExitProcess(0);
+}
+static _BOOLEAN HarnessWrite(CVector<short>& psData)
+{
+	static DWORD t0 = 0; static double speed = 2.0; static bool tried = false;
+	g_txlock.lock();
+	if (!tried) {
+		tried = true;
+		g_txwav = fopen(getenv("EASYDRF_TXWAV"), "wb");
+		if (g_txwav) {
+			unsigned char h[44] = { 'R','I','F','F',0,0,0,0,'W','A','V','E','f','m','t',' ',16,0,0,0,1,0,1,0,
+				0x80,0xBB,0,0, 0x00,0x77,0x01,0, 2,0,16,0,'d','a','t','a',0,0,0,0 };
+			fwrite(h, 1, 44, g_txwav);
+		}
+		t0 = GetTickCount();
+		const char* sp = getenv("EASYDRF_SPEED");
+		if (sp) speed = atof(sp);
+	}
+	const int n = psData.Size() / 2;
+	if (g_txwav) for (int i = 0; i < n; i++) { short s = psData[2 * i]; fwrite(&s, 2, 1, g_txwav); }
+	g_txsamples += n;
+	g_txlock.unlock();
+	double due = g_txsamples * 1000.0 / 48000.0 / speed;
+	DWORD now = GetTickCount() - t0;
+	if (due > now) Sleep((DWORD)(due - now));
+	return FALSE;
+}
