+/* DecHAMDRM interop harness, transmit side (see sound/Sound.cpp): with EASYDRF_TXWAV set
+   the program starts a transmission by itself two seconds after start-up.
+   EASYDRF_TXFILES=a;b;c sends files (RS level from settings.txt "Instances/RS"),
+   without it speech from EASYDRF_MIC is sent (EASYDRF_CODEC=speex|lpc).
+   EASYDRF_PROT=0|1 sets the MSC protection level. Local test build only. */
+void HarnessFinishTx();
+void OnCommand(HWND hwnd, int ctrlid, int code);
+void HarnessTx(void* dummy)
+{
+	Sleep(2000);
+	const char* pr = getenv("EASYDRF_PROT");
+	if (pr) DRMTransmitter.GetParameters()->SetMSCProtLev(atoi(pr));
+	const char* files = getenv("EASYDRF_TXFILES");
+	/* EASYDRF_TXBSR=file: a BSR request (plain text form) is compressed and sent twice, as the BSR window does. */
+	const char* bsr = getenv("EASYDRF_TXBSR");
+	static char bsrlist[40];
+	if (bsr) { compressBSR((char*)bsr, (char*)"bsr.bin"); strcpy(bsrlist, "bsr.bin;bsr.bin"); files = bsrlist; }
+	if (!files) {
+		const char* c = getenv("EASYDRF_CODEC");
+		if (c && !strcmp(c, "speex")) TransmParam->Service[0].AudioParam.eAudioCoding = CParameter::AC_SPEEX;
+		OnCommand(mainwindow, IDB_START, 0);
+		return;
+	}
+	char list[4000]; strncpy(list, files, sizeof(list) - 1); list[sizeof(list) - 1] = 0;
+	TXpicpospt = 0;
+	for (char* tok = strtok(list, ";"); tok && TXpicpospt < 32; tok = strtok(nullptr, ";")) {
+		strcpy(pictfile[TXpicpospt], tok);
+		const char* b = strrchr(tok, '\\'); const char* b2 = strrchr(tok, '/');
+		if (b2 > b) b = b2;
+		strcpy(filetitle[TXpicpospt], b ? b + 1 : tok);
+		FILE* f = fopen(tok, "rb");
+		if (f) { fseek(f, 0, SEEK_END); file_size[TXpicpospt] = ftell(f); fclose(f); TXpicpospt++; }
+	}
+	if (TXpicpospt == 0) HarnessFinishTx();
+	SetTXmode(TRUE);
+	IsRX2 = FALSE;
+	DRMTransmitter.Init();
+	DRMTransmitter.Send();
+}
